{
  "name": "@edelweiss/sdk",
  "version": "0.0.0-dev",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.tsx",
      "import": "./src/testing.tsx"
    },
    "./vite": {
      "types": "./vite.ts",
      "import": "./vite.ts"
    },
    "./extension.css": "./extension.css"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build:package": "vite build && vite build -c vite.pack.config.ts && tsc -p tsconfig.pack.json && cp extension.css dist/extension.css"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@tailwindcss/vite": "4.3.3",
    "lightningcss": "1.33.0",
    "vite-plugin-solid": "^2.11.15"
  },
  "peerDependencies": {
    "@solidjs/router": "^1.0.1",
    "daisyui": "^5.7.50",
    "solid-js": "^1.9.18",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@solidjs/router": "^1.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "daisyui": "^5.7.50",
    "jsdom": "^30.1.3",
    "solid-js": "^1.9.18",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
